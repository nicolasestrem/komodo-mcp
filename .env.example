# =====================================================================
# Komodo MCP Server — example environment
# Copy to .env and fill in values. .env is gitignored.
# Generate the auth token with:  openssl rand -hex 32
# =====================================================================

# ---- Komodo Core ----
KOMODO_ADDRESS=http://localhost:9120
KOMODO_API_KEY=
KOMODO_API_SECRET=

# Optional client tuning (defaults shown)
# KOMODO_TIMEOUT_MS=30000
# KOMODO_MAX_RETRIES=2
# KOMODO_MAX_CONCURRENCY=8

# ---- MCP transport ----
# streamable (default) | sse (legacy) | stdio (no HTTP server)
MCP_TRANSPORT=streamable
MCP_PORT=3113
# Outside Docker default to 127.0.0.1; inside Docker the compose file
# already sets MCP_BIND_HOST=0.0.0.0 because the host port mapping is
# the network boundary.
MCP_BIND_HOST=127.0.0.1

# ---- MCP auth (REQUIRED for non-loopback callers) ----
# When unset, only loopback IPs are admitted.
MCP_AUTH_TOKEN=

# Comma-separated lists. Empty Origins = no Origin enforcement.
MCP_ALLOWED_ORIGINS=
MCP_ALLOWED_HOSTS=127.0.0.1,localhost

# ---- Logging ----
LOG_LEVEL=info
